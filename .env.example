# Copy to .env and fill in. Never commit .env.

# --- Google Gemini (free API key from https://aistudio.google.com/apikey) ---
# Optional. With a key, agents use Gemini first and fall back to Foundry Local.
GEMINI_API_KEY=
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
# Client-side pacing per Gemini model (free tier is rate-limited per minute)
GEMINI_RPM=10

# --- Microsoft Foundry Local (runs on this machine; no account or key) ---
# Install: winget install Microsoft.FoundryLocal
FOUNDRY_LOCAL_MODEL=qwen2.5-1.5b
FOUNDRY_LOCAL_DEVICE=cpu

# --- Provider chain (optional) ---
# Ordered fallback list of kind:model. Default: two Gemini models then Foundry
# Local when GEMINI_API_KEY is set, otherwise Foundry Local only.
# LLM_CHAIN=gemini:gemini-flash-lite-latest,gemini:gemini-3.5-flash,foundry_local:qwen2.5-1.5b
# LLM_TIMEOUT_S=60
