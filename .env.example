# Copy to .env and fill in. Never commit .env.

# Which LLM provider the agents use: foundry_local (default) or gemini
LLM_PROVIDER=foundry_local

# --- Microsoft Foundry Local (runs on this machine; no account or key) ---
# Install: winget install Microsoft.FoundryLocal
FOUNDRY_LOCAL_MODEL=qwen2.5-1.5b
FOUNDRY_LOCAL_DEVICE=cpu

# --- Google Gemini (free API key from https://aistudio.google.com/apikey) ---
GEMINI_API_KEY=
GEMINI_MODEL=gemini-flash-latest
GEMINI_ENDPOINT=https://generativelanguage.googleapis.com/v1beta/openai/
